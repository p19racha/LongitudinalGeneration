# Dockerfile for PULSE Clinical Decision Support System (Backend)
FROM python:3.12-slim AS base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch CPU and Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    fastapi>=0.110.0 \
    uvicorn>=0.28.0 \
    sqlalchemy>=2.0.0 \
    pydantic>=2.6.0 \
    pydantic-settings>=2.2.0 \
    numpy>=1.24.0 \
    pandas>=2.0.0 \
    scikit-learn>=1.3.0 \
    tqdm>=4.66.0 \
    httpx>=0.27.0

# Copy application source code
COPY pulse/ ./pulse/
COPY server/ ./server/
COPY scripts/ ./scripts/
COPY setup.py ./

# Install pulse package in editable mode
RUN pip install -e .

# Create data directory for SQLite database and audit trail
RUN mkdir -p /app/data

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV PULSE_DB_PATH=/app/data/pulse_cdss.db

CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
